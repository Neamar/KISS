<?xml version="1.0" encoding="utf-8"?>
<!-- Grid cell: icon on top, short one-line name below -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/GridItem">

    <FrameLayout
        android:layout_width="@dimen/grid_icon_size"
        android:layout_height="@dimen/grid_icon_size">

        <ImageView
            android:id="@+id/item_shortcut_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            tools:src="@drawable/ic_launcher_white" />

        <ImageView
            android:id="@+id/item_app_icon"
            android:layout_width="?attr/resultSubIconSize"
            android:layout_height="?attr/resultSubIconSize"
            android:layout_gravity="end|bottom"
            android:contentDescription="@null"
            tools:layout_height="@dimen/result_subicon_size"
            tools:layout_width="@dimen/result_subicon_size"
            tools:src="@drawable/ic_launcher_white" />
    </FrameLayout>

    <TextView
        android:id="@+id/item_app_name"
        style="@style/GridItemLabel"
        tools:text="@string/stub_application" />

</LinearLayout>
