<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="BaseTheme">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="dividerDrawable">@drawable/list_separator</item>
        <item name="searchColor">@color/theme_solid_search_color</item>
        <item name="resultColor">@color/theme_solid_result_color</item>
        <item name="resultShadowColor">@color/theme_solid_result_shadow_color</item>
        <item name="listBackgroundColor">@color/theme_solid_list_background_color</item>
        <item name="searchBackgroundColor">@color/theme_solid_search_background_color</item>
        <item name="searchBackgroundOutline">@android:color/transparent</item>
    </style>

    <style name="AppThemeAmoledDark" parent="AppTheme">
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="dividerDrawable">@null</item>
        <item name="searchColor">@android:color/white</item>
        <item name="resultColor">@android:color/white</item>
        <item name="resultShadowColor">@android:color/black</item>
        <item name="listBackgroundColor">@android:color/black</item>
        <item name="searchBackgroundColor">@android:color/black</item>
        <item name="searchBackgroundOutline">@android:color/white</item>
    </style>

    <style name="AppThemeTransparent" parent="AppTheme">
        <item name="dividerDrawable">@null</item>
        <item name="colorPrimaryDark">@android:color/transparent</item>
        <item name="textShadowRadius">3</item>
        <item name="listBackgroundColor">@android:color/transparent</item>
        <item name="resultColor">@color/theme_transparent_result_color</item>
        <item name="resultShadowColor">@color/theme_transparent_result_shadow_color</item>
    </style>

    <style name="AppThemeSemiTransparent" parent="AppTheme">
        <item name="dividerDrawable">@null</item>
        <item name="textShadowRadius">3</item>
        <item name="resultColor">@color/theme_semi_transparent_result_color</item>
        <item name="listBackgroundColor">@color/theme_semi_transparent_list_background_color</item>
        <item name="searchBackgroundColor">@color/theme_semi_transparent_search_background_color</item>
    </style>

    <style name="SettingTheme" parent="AppTheme">
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowBackground">@color/setting_theme_window_background</item>
    </style>

    <style name="SettingThemeAmoledDark" parent="AppThemeAmoledDark">
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <style name="OverlayAccentSystem" parent="OverlayAccentDefault">
        <item name="colorPrimary">@android:color/system_accent1_200</item>
        <item name="colorPrimaryDark">@android:color/system_accent1_400</item>
        <item name="colorAccent">@android:color/system_accent1_600</item>
    </style>
</resources>
