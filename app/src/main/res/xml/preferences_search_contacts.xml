<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto"
    app:title="@string/contacts_name">
    <SwitchPreference
        app:defaultValue="true"
        app:disableDependentsState="true"
        app:key="contact-pack-mask"
        app:summary="@string/contact_pack_mask_desc"
        app:title="@string/contact_pack_mask" />
    <ListPreference
        app:defaultValue="0"
        app:dependency="contact-pack-mask"
        app:entries="@array/adaptiveEntriesForContacts"
        app:entryValues="@array/adaptiveValues"
        app:key="contacts-shape"
        app:summary="@string/contacts_shape_summary"
        app:title="@string/contacts_shape" />
    <PreferenceCategory
        app:key="contact-actions"
        app:summary="@string/contact_actions_summary"
        app:title="@string/contact_actions">
        <fr.neamar.kiss.preference.ContactActionPreference
            app:defaultValue="sms"
            app:key="contact-action-left"
            app:title="@string/contact_action_left"
            app:useSimpleSummaryProvider="true" />
        <fr.neamar.kiss.preference.ContactActionPreference
            app:defaultValue="call"
            app:key="contact-action-right"
            app:title="@string/contact_action_right"
            app:useSimpleSummaryProvider="true" />
        <Preference
            app:selectable="false"
            app:summary="@string/contact_actions_override_hint" />
        <SwitchPreference
            app:defaultValue="false"
            app:key="call-contact-on-click"
            app:title="@string/contacts_call_on_click" />
    </PreferenceCategory>
</PreferenceScreen>
