<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:title="@string/title_home_screen">
    <PreferenceCategory app:title="@string/history_hide_name">
        <SwitchPreference
            app:defaultValue="false"
            app:key="history-hide"
            app:summary="@string/history_hide_desc"
            app:title="@string/history_hide_name">
            <extra
                android:name="restart"
                android:value="launcher" />
        </SwitchPreference>
        <SwitchPreference
            app:defaultValue="false"
            app:dependency="history-hide"
            app:key="history-onclick"
            app:title="@string/history_onclick_name" />
        <SwitchPreference
            app:defaultValue="false"
            app:dependency="history-hide"
            app:key="history-onkeyboard"
            app:summary="@string/history_onkeyboard_desc"
            app:title="@string/history_onkeyboard_name" />
        <SwitchPreference
            app:defaultValue="false"
            app:dependency="history-hide"
            app:key="favorites-hide"
            app:title="@string/favorites_hide" />
        <fr.neamar.kiss.preference.RangeEditTextPreference
            app:defaultValue="0"
            app:dependency="history-hide"
            app:key="widget-spacing"
            app:minValue="0"
            app:maxValue="300"
            app:title="@string/widget_spacing_name"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>
    <PreferenceCategory app:title="@string/system_bars">
        <SwitchPreference
            app:defaultValue="false"
            app:key="pref-hide-statusbar"
            app:summary="@string/pref_hide_statusbar_desc"
            app:title="@string/pref_hide_statusbar" />
        <SwitchPreference
            app:defaultValue="false"
            app:key="pref-hide-navbar"
            app:summary="@string/pref_hide_navbar_desc"
            app:title="@string/pref_hide_navbar" />
    </PreferenceCategory>
    <PreferenceCategory>
        <SwitchPreference
            app:defaultValue="false"
            app:key="force-portrait"
            app:title="@string/portrait_title">
            <extra
                android:name="restart"
                android:value="settings" />
        </SwitchPreference>
        <Preference
            app:fragment="fr.neamar.kiss.settings.WallpaperSettingsFragment"
            app:key="wallpaper-holder"
            app:title="@string/title_wallpaper" />
    </PreferenceCategory>
</PreferenceScreen>
