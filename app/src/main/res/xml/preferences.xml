<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:title="@string/activity_setting">
    <Preference
        app:fragment="fr.neamar.kiss.settings.HistorySettingsFragment"
        app:key="history_category"
        app:summary="@string/history_settings_summary"
        app:title="@string/title_history" />
    <Preference
        app:fragment="fr.neamar.kiss.settings.FavoritesSettingsFragment"
        app:key="history_favorites"
        app:summary="@string/history_favorites_summary"
        app:title="@string/title_favorites" />
    <Preference
        app:fragment="fr.neamar.kiss.settings.UserInterfaceSettingsFragment"
        app:key="ui-holder"
        app:summary="@string/user_interface_summary"
        app:title="@string/title_ui" />
    <Preference
        app:fragment="fr.neamar.kiss.settings.UserExperienceSettingsFragment"
        app:key="ux-holder"
        app:summary="@string/user_experience_summary"
        app:title="@string/title_ux" />
    <Preference
        app:fragment="fr.neamar.kiss.settings.SearchSettingsFragment"
        app:key="providers"
        app:summary="@string/providers_summary"
        app:title="@string/title_providers" />
    <Preference
        app:fragment="fr.neamar.kiss.settings.ExcludedEntriesSettingsFragment"
        app:key="exclude_apps_category"
        app:summary="@string/ui_excluded_apps_dialog_title"
        app:title="@string/settings_excluded_apps" />
    <Preference
        app:fragment="fr.neamar.kiss.settings.ImportExportSettingsFragment"
        app:key="importexport"
        app:title="@string/title_import_export" />
    <Preference
        app:fragment="fr.neamar.kiss.settings.AdvancedSettingsFragment"
        app:key="advanced"
        app:title="@string/title_advanced" />
    <Preference
        app:key="rate-app"
        app:title="@string/rate_the_app" />
</PreferenceScreen>
