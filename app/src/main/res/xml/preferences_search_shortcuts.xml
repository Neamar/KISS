<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:title="@string/shortcuts_name">
    <Preference
        app:fragment="fr.neamar.kiss.settings.ExcludeAppSettingsFragment"
        app:key="edit-excluded-app-shortcuts"
        app:summary="@string/ui_excluded_from_shortcuts_apps_summary"
        app:title="@string/ui_excluded_from_shortcuts_apps">
        <extra
            android:name="minSdk"
            android:value="26" />
        <extra
            android:name="exclusion"
            android:value="edit-excluded-app-shortcuts" />
    </Preference>
    <fr.neamar.kiss.preference.DialogShowingPreference
        app:dialogMessage="@string/regenerate_shortcuts_desc"
        app:key="reset-shortcuts"
        app:title="@string/regenerate_shortcuts">
        <extra
            android:name="minSdk"
            android:value="26" />
    </fr.neamar.kiss.preference.DialogShowingPreference>
</PreferenceScreen>
