<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:title="@string/shortcuts_name">
    <SwitchPreference
        app:defaultValue="true"
        app:key="subicon-visible"
        app:title="@string/show_subicons">
        <extra
            android:name="minSdk"
            android:value="26" />
    </SwitchPreference>
    <Preference
        app:fragment="fr.neamar.kiss.settings.ExcludeAppSettingsFragment"
        app:key="edit-excluded-app-shortcuts"
        app:summary="@string/ui_excluded_apps_dialog_title"
        app:title="@string/ui_excluded_from_shortcuts_apps">
        <extra
            android:name="minSdk"
            android:value="26" />
        <extra
            android:name="exclusion"
            android:value="edit-excluded-app-shortcuts" />
    </Preference>
    <fr.neamar.kiss.preference.DialogShowingPreference
        app:dialogMessage="@string/reset_excluded_app_shortcuts_warn"
        app:key="reset-excluded-app-shortcuts"
        app:title="@string/reset_excluded_app_shortcuts_name">
        <extra
            android:name="minSdk"
            android:value="26" />
    </fr.neamar.kiss.preference.DialogShowingPreference>
    <fr.neamar.kiss.preference.DialogShowingPreference
        app:dialogMessage="@string/regenerate_shortcuts_desc"
        app:key="reset-shortcuts"
        app:title="@string/regenerate_shortcuts">
        <extra
            android:name="minSdk"
            android:value="26" />
    </fr.neamar.kiss.preference.DialogShowingPreference>
</PreferenceScreen>
